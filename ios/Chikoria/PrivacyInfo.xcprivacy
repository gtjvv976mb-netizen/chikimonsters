<?xml version="1.0" encoding="UTF-8"?>
<!--
  The app's privacy manifest. Add it to the app target in Xcode (File → New → File → App Privacy),
  or drag this one in and make sure it is in "Copy Bundle Resources".

  THIS FILE DESCRIBES THE APP AS IT IS BUILT TODAY, and it has to stay true as the app changes.
  Two of these answers in particular are only correct because of decisions made elsewhere:

    * NSPrivacyTracking is false because the app contains no advertising SDK, no analytics SDK and
      no third-party framework of any kind. If telemetry is ever added, it has to be declared here
      AND in the App Privacy answers in App Store Connect, and the two must agree.

    * NSPrivacyCollectedDataTypes lists what leaves the phone and is kept by the game server, all
      of it but the diagnostics linked to the player, none of it used for tracking, all of it for App Functionality:
        - User ID: the app can CREATE an account (/account/new), and the account id travels with
          every save.
        - Device ID: a random id generated on first launch (LinkKeychain.swift), sent with the
          link token so a device can be listed and revoked. Not the IDFA, not identifierForVendor.
        - Gameplay Content: the save — creatures, items, progress — syncs to the account so the
          same player can continue on the website.
        - Other Diagnostic Data, NOT linked: when the realm fails to load, the shell reports what it
          saw (load stages and timings, web content process deaths, the page's errors, hardware
          model, iOS version) to /client-diag under a random per-launch id — no account, no device
          id. See ShellModel's "Load diagnostics".
      These must match the App Privacy answers in App Store Connect (APPSTORE.md §3).

  REQUIRED-REASON APIS: the app links UserDefaults through Foundation (SwiftUI and WKWebView both
  touch it), which is a required-reason API even when your own code never calls it directly. CA92.1
  is the correct reason for an app that only reads and writes its own defaults inside its own
  container. The other required-reason categories — file timestamps, disk space, active keyboards,
  system boot time — are not used by this app's own code.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeGameplayContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access only to defaults in the app's own container. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
