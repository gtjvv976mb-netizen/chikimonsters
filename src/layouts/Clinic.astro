---
import '../styles/global.css';
import type { Clinic } from '../data/demo';

interface Props {
  clinic: Clinic;
  title: string;
  section: 'today' | 'patients' | 'billing' | 'claims';
}

const { clinic, title, section } = Astro.props;

const nav = [
  { id: 'today', label: 'Today', href: `/c/${clinic.slug}/` },
  { id: 'patients', label: 'Patients', href: `/c/${clinic.slug}/patients/` },
  { id: 'billing', label: 'Billing', href: `/c/${clinic.slug}/#billing` },
  { id: 'claims', label: 'HMO claims', href: `/c/${clinic.slug}/#claims` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — {clinic.name} — Flossify</title>
    <!-- A clinic workspace is private by definition. Keep it out of indexes
         even before auth exists, so nothing is ever discoverable by search. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage blocked: fall back to the OS preference */
      }
    </script>
  </head>
  <body>
    <div
      role="alert"
      class="border-b border-crown/40 bg-crown/10 px-5 py-2.5 text-center text-[13px] font-medium text-ink sm:px-8"
    >
      Prototype with invented data. No authentication yet — do not put real patient records in this.
    </div>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-3 px-5 py-3 sm:px-8">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2" aria-label="Flossify, home">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-accent" aria-hidden="true">
              <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
              <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <span class="h-5 w-px bg-line"></span>
          <div>
            <p class="font-display text-[17px] leading-tight font-bold">{clinic.name}</p>
            <p class="text-[11px] text-muted">{clinic.group} &middot; {clinic.city}</p>
          </div>
        </div>

        <nav class="flex items-center gap-1" aria-label="Clinic sections">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={n.id === section ? 'page' : undefined}
              class:list={[
                ' px-3.5 py-2 text-[13.5px] font-medium',
                n.id === section ? 'bg-accent text-surface' : 'text-ink-2 hover:bg-bg-soft hover:text-accent',
              ]}
            >
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-[1280px] px-5 py-8 sm:px-8">
      <slot />
    </main>
  </body>
</html>
