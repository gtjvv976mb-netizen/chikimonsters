---
import Base from '../layouts/Base.astro';
import { clinics, patientsOf, appointmentsOf } from '../data/demo';
---

<Base
  title="Clinic workspaces — Flossify"
  description="Every clinic gets its own workspace link. Staff sign in and go straight to today's chairs."
>
  <main id="main" class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8">
    <a href="/" class="text-[14.5px] font-medium text-accent">&larr; Back to the site</a>

    <h1 class="mt-6 max-w-[760px] font-display text-[clamp(2rem,5vw,3rem)] leading-tight font-semibold tracking-[-0.025em]">
      Every clinic gets its own workspace.
    </h1>
    <p class="mt-4 max-w-[620px] text-[17px] leading-relaxed text-ink-2">
      One link per branch, bookmarkable, going straight to today's chairs. Group owners see every
      branch; an associate sees only the ones they work at.
    </p>

    <div
      role="note"
      class="mt-8 max-w-[720px] rounded-2xl border border-crown/40 bg-crown/10 p-5 text-[14.5px] leading-relaxed"
    >
      <strong class="font-semibold">These links are open because there is no login yet.</strong>
      In production every one of them sits behind authentication. A workspace URL is an address,
      never a credential — anything reachable by guessing a clinic name is a reportable breach
      under the Data Privacy Act, not a convenience feature.
    </div>

    <ul class="mt-10 grid gap-5 lg:grid-cols-2">
      {clinics.map((c) => {
        const patients = patientsOf(c.slug);
        const today = appointmentsOf(c.slug);
        return (
          <li class="rounded-3xl border border-line bg-surface p-7">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-display text-[26px] font-semibold tracking-tight">{c.name}</h2>
                <p class="mt-1 text-[14.5px] text-muted">{c.group} &middot; {c.city}, {c.province}</p>
              </div>
              {c.tin ? (
                <span class="shrink-0 rounded-full bg-accent/10 px-3 py-1.5 text-xs font-semibold text-accent">
                  BIR ready
                </span>
              ) : (
                <span class="shrink-0 rounded-full bg-crown/15 px-3 py-1.5 text-xs font-semibold text-crown">
                  TIN missing
                </span>
              )}
            </div>

            <dl class="mt-5 grid grid-cols-3 gap-4 border-t border-line-2 pt-5">
              <div>
                <dt class="text-xs tracking-[0.08em] text-muted uppercase">Patients</dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums">{patients.length}</dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.08em] text-muted uppercase">Today</dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums">{today.length}</dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.08em] text-muted uppercase">Chairs</dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums">{c.chairs}</dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href={`/c/${c.slug}/`}
                class="rounded-full bg-accent px-6 py-3 text-[14.5px] font-semibold text-surface hover:bg-accent-deep"
              >
                Open workspace
              </a>
              <code class="rounded-lg bg-bg-soft px-3 py-2 text-[13px] text-muted">/c/{c.slug}</code>
            </div>
          </li>
        );
      })}
    </ul>
  </main>
</Base>
