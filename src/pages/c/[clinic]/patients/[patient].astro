---
import ClinicLayout from '../../../../layouts/Clinic.astro';
import Odontogram from '../../../../components/Odontogram.astro';
import {
  clinics, clinicBySlug, patientsOf, peso, CONDITION_LABEL, surfaceSummary,
  type ToothCondition, type ToothMark,
} from '../../../../data/demo';

export function getStaticPaths() {
  return clinics.flatMap((c) =>
    patientsOf(c.slug).map((p) => ({
      params: { clinic: c.slug, patient: p.id },
      props: { patient: p },
    }))
  );
}

const { clinic: slug } = Astro.params;
const { patient } = Astro.props;
const clinic = clinicBySlug(slug!)!;

const age = Math.floor(
  (new Date('2026-09-21').getTime() - new Date(patient.birthDate).getTime()) / 31_557_600_000
);
const minor = age < 18;

// Existing findings, newest concern first so the dentist reads problems before
// completed work.
const ORDER: ToothCondition[] = [
  'caries', 'missing', 'impacted', 'unerupted', 'root_canal',
  'crown', 'bridge', 'implant', 'veneer', 'filled', 'sealant', 'sound',
];
const findings = Object.entries(patient.teeth)
  .map(([fdi, mark]) => {
    const m = mark as ToothMark;
    return { fdi: Number(fdi), condition: m.condition, codes: surfaceSummary(Number(fdi), m.surfaces) };
  })
  .sort((a, b) => ORDER.indexOf(a.condition) - ORDER.indexOf(b.condition) || a.fdi - b.fdi);
---

<ClinicLayout clinic={clinic} title={`${patient.firstName} ${patient.lastName}`} section="patients">
  <a href={`/c/${clinic.slug}/patients/`} class="text-[14.5px] font-medium text-accent">&larr; All patients</a>

  <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
    <div>
      <h1 class="font-display text-[clamp(1.75rem,4vw,2.5rem)] leading-tight font-semibold tracking-[-0.02em]">
        {patient.firstName} {patient.lastName}
      </h1>
      <p class="mt-1.5 text-[15px] text-muted">
        {patient.chartNo} &middot; {age} years old &middot; {patient.phone}
      </p>
    </div>
    <div class="text-right">
      <p class="text-xs font-semibold tracking-[0.09em] text-muted uppercase">Balance</p>
      <p class="mt-1 font-display text-[30px] leading-none font-bold tabular-nums">
        {patient.balance === 0 ? '—' : peso(patient.balance)}
      </p>
    </div>
  </div>

  {(patient.allergies.length > 0 || patient.conditions.length > 0 || minor) && (
    <div role="alert" class="mt-6 flex flex-wrap gap-2.5">
      {patient.allergies.map((a) => (
        <span class="bg-caries/15 px-4 py-2 text-[13.5px] font-semibold text-caries">
          Allergy: {a}
        </span>
      ))}
      {patient.conditions.map((c) => (
        <span class="bg-crown/15 px-4 py-2 text-[13.5px] font-semibold text-crown">{c}</span>
      ))}
      {minor && (
        <span class="bg-crown/15 px-4 py-2 text-[13.5px] font-semibold text-crown">
          Minor — guardian consent required
        </span>
      )}
    </div>
  )}

  <section class="mt-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-display text-[22px] font-semibold">Odontogram</h2>
      <p class="text-[13.5px] text-muted">
        Stored in FDI; displayed in this clinic's preference. Click a tooth to change a finding.
      </p>
    </div>
    <div class="mt-4">
      <Odontogram marks={patient.teeth} notation={clinic.notation} />
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-[22px] font-semibold">Findings on record</h2>
    {findings.length === 0 ? (
      <p class="mt-3 text-[15px] text-muted">Nothing charted yet.</p>
    ) : (
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {findings.map((f) => (
          <li class="flex items-center gap-3 border border-line bg-surface px-4 py-3.5">
            <span class="tooth h-8! w-6! shrink-0" data-state={f.condition} aria-hidden="true"></span>
            <div>
              <p class="text-[15px] font-semibold tabular-nums">
                Tooth {f.fdi}{f.codes && <span class="text-accent"> {f.codes}</span>}
              </p>
              <p class="text-[13.5px] text-ink-2">{CONDITION_LABEL[f.condition]}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-10 border border-line-2 bg-bg-soft p-6">
    <h2 class="font-display text-[19px] font-semibold">Not built yet</h2>
    <p class="mt-2 max-w-[640px] text-[15px] leading-relaxed text-ink-2">
      Procedures, treatment plans, prescriptions, consent forms, X-ray attachments, invoices and the
      audit trail all have tables in <code class="bg-surface px-1.5 py-0.5 text-[13.5px]">src/data/schema.sql</code>
      and no screens yet. Changes here are not saved — there is no database wired up, and no login in
      front of it.
    </p>
  </section>
</ClinicLayout>
