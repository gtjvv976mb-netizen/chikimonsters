---
import Base from '../layouts/Base.astro';
import lqip from '../data/lqip.json';

// Real screens from the clinic workspace in this repo. Nothing mocked up.
const screens = [
  {
    id: 'queue',
    tab: 'The day',
    title: 'Who has arrived, who is waiting, who is in the chair',
    body: 'The front desk stops asking you, and you stop asking them. Allergies and alerts sit on the row, not three clicks away.',
  },
  {
    id: 'patients',
    tab: 'Patients',
    title: 'Every record, one search away',
    body: 'Chart number, name, age, alerts, last visit, balance. Nothing to open before you know what you are looking at.',
  },
  {
    id: 'tiles',
    tab: 'At a glance',
    title: 'The numbers that actually change your week',
    body: 'In the chair, waiting, owed by patients, and stuck with HMOs. The last one is money you have already earned.',
  },
];

// Object photography only — equipment, teeth, braces, tools. No faces.
const services = [
  {
    img: 'instruments', w: 1600,
    alt: 'Stainless dental instruments laid out in a row on a folded cloth',
    title: 'Records that stay tidy',
    body: 'History, notes, images and what they still owe. One patient, one place, no folder to hunt for.',
  },
  {
    img: 'handpiece', w: 1000,
    alt: 'A dental handpiece and bur resting on a pale worktop',
    title: 'Charting that keeps up',
    body: 'Tooth, surfaces, finding. It reads back the way you would write it, so the note still makes sense next year.',
  },
  {
    img: 'aligner', w: 1600,
    alt: 'A clear orthodontic aligner standing on a pale stone surface',
    title: 'Treatment plans patients follow',
    body: 'Show the plan, the cost and what the HMO covers, in something they can take home and show whoever is paying.',
  },
  {
    img: 'xray', w: 1000,
    alt: 'A panoramic dental radiograph on a softly glowing light box',
    title: 'Images on the record',
    body: 'Radiographs and photos land on the patient, not in a folder on the desktop named final_2.',
  },
  {
    img: 'model', w: 1000,
    alt: 'A white dental study model of upper and lower teeth',
    title: 'Paperwork that fills itself',
    body: 'Consent, certificates, clearances, prescriptions. The details you already hold get filled in for you.',
  },
  {
    img: 'tray', w: 1000,
    alt: 'A stainless instrument tray with a mouth mirror and probe',
    title: 'Money, without the headache',
    body: 'Proper receipts, what each patient owes, and what the HMOs have not paid. One view you can read.',
  },
];

const forClinics = [
  'Runs on the tablet at the chair and the desktop at the desk',
  'Keeps working through a brownout, and catches up after',
  'Every branch its own day, all of them in one view',
  'Your records leave with you if you ever go',
];

const forPatients = [
  'Fill your history at home, on your own phone',
  'Sign consent without a clipboard',
  'A reminder the night before, not a phone call at work',
  'Know what a treatment costs before you agree to it',
];

const faqs = [
  { q: 'Do I need to be good with computers?', a: 'No. If you can use a phone, you can use this. The parts you touch every day are the ones we worked hardest to make obvious, and we sit with you for the first week.' },
  { q: 'I already use something else. Is moving painful?', a: 'It is our job, not yours. Send us whatever you have — another system, a spreadsheet, a shelf of index cards — and we bring the patients, charts and balances across while you carry on working.' },
  { q: 'What happens to my records if I ever leave?', a: 'You take everything with you, in a format you can open without us. No exit fee. They were always yours.' },
  { q: 'Does it work when the internet is down?', a: 'Charting, notes and your schedule run on the device in front of you and catch up quietly when the connection returns. Messages and card payments do need a signal, and the app is honest about which is which.' },
  { q: 'Who is behind it?', a: 'A small team in Baguio City. You talk to the people who build it, which is why things get fixed quickly.' },
];
---

<Base
  title="Flossify — dental software your whole clinic can actually use"
  description="Records, charting, the day's queue and payments for dental clinics. Designed around the people using it, not the people buying it."
>
  <header class="fixed top-0 right-0 left-0 z-50 border-b border-line-2 bg-bg/75 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
      <a href="/" class="group flex items-center gap-2.5" aria-label="Flossify, home">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent/10 text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-surface">
          <span class="tooth-marker"></span>
        </span>
        <span class="font-display text-[21px] leading-none font-bold tracking-[-0.02em]">Flossify</span>
      </a>
      <nav class="flex items-center gap-1.5 sm:gap-3" aria-label="Main">
        <a href="#product" class="hidden rounded-full px-3.5 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:bg-bg-soft hover:text-ink md:inline-block">See it</a>
        <a href="#services" class="hidden rounded-full px-3.5 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:bg-bg-soft hover:text-ink md:inline-block">What it does</a>
        <a href="#faq" class="hidden rounded-full px-3.5 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:bg-bg-soft hover:text-ink md:inline-block">Questions</a>
        <button
          type="button"
          data-theme-toggle
          class="ml-1 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-line text-ink-2 transition-colors hover:border-accent hover:text-accent"
          aria-label="Switch between light and dark theme"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"></path>
          </svg>
        </button>
        <a href="/clinics/" class="btn btn-quiet px-5 py-2.5 text-[14.5px]">Clinic sign in</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-[#143b3c] text-[#eef5f2]">
      <figure class="media absolute inset-y-0 right-0 hidden w-[64%] lg:block" style={`background-image:url("${lqip.braces}")`}>
        <img
          src="/img/braces-1600.webp"
          srcset="/img/braces-960.webp 960w, /img/braces-1600.webp 1600w"
          sizes="52vw"
          alt="A dental study model fitted with ceramic orthodontic brackets"
          width="1600" height="900"
          fetchpriority="high"
          data-fade
        />
      </figure>
      <div
        class="absolute inset-0 hidden lg:block"
        style="background:linear-gradient(95deg,#143b3c 34%,rgba(20,59,60,0.94) 44%,rgba(20,59,60,0.45) 62%,rgba(20,59,60,0.08) 80%,transparent 92%)"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto max-w-[1180px] px-5 pt-36 pb-20 sm:px-8 sm:pt-44 sm:pb-28">
        <p class="reveal flex items-center gap-2.5 text-[13px] font-semibold tracking-[0.12em] text-[#7fd2bd] uppercase">
          <span class="tooth-marker"></span>Dental clinic software · Baguio City
        </p>
        <h1 class="reveal reveal-d1 mt-6 max-w-[16ch] font-display text-[clamp(2.75rem,6.5vw,4.5rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-[#f4faf7]">
          Dental software your whole clinic can actually use.
        </h1>
        <p class="reveal reveal-d2 mt-7 max-w-[46ch] text-[clamp(1.0625rem,1.5vw,1.25rem)] leading-[1.55] text-[#b8d4cc]">
          Designed around the dentist, the front desk and the patient — not around the person
          signing the cheque.
        </p>
        <div class="reveal reveal-d3 mt-10 flex flex-wrap items-center gap-3.5">
          <a href="#product" class="btn bg-[#7fd2bd] text-[#0d2a2b] hover:bg-[#9ee0cf]">See it working</a>
          <a href="/clinics/" class="btn border-[#eef5f2]/25 bg-[#eef5f2]/5 text-[#eef5f2] hover:border-[#7fd2bd] hover:text-[#7fd2bd]">
            Open a demo clinic
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
      <!-- PRODUCT -->
      <section id="product" class="scroll-mt-24 pt-24 sm:pt-32">
        <div class="mx-auto max-w-[50ch] text-center">
          <p class="eyebrow reveal">The actual software</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-[clamp(2.125rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
            No demo call to see the product
          </h2>
          <p class="reveal reveal-d2 mt-5 text-[17.5px] leading-[1.6] text-ink-2">
            These are real screens, running. Pick one.
          </p>
        </div>

        <div class="reveal mt-10" data-tabs>
          <div class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Product screens">
            {screens.map((s, i) => (
              <button
                type="button"
                class="tab"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={`panel-${s.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {s.tab}
              </button>
            ))}
          </div>

          <div class="mt-8">
            {screens.map((s, i) => (
              <div
                class:list={['panel', i === 0 && 'is-shown']}
                role="tabpanel"
                id={`panel-${s.id}`}
                aria-labelledby={`tab-${s.id}`}
                hidden={i !== 0}
              >
                <div class="frame">
                  <div class="frame-bar" aria-hidden="true">
                    <span class="frame-dot"></span>
                    <span class="frame-dot"></span>
                    <span class="frame-dot"></span>
                  </div>
                  <figure class="media media-auto" style={`background-image:url("${lqip[`shot-${s.id}`]}")`}>
                    <img
                      src={`/shots/${s.id}.webp`}
                      alt={`The ${s.tab.toLowerCase()} screen in Flossify`}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      data-fade
                    />
                  </figure>
                </div>
                <div class="mx-auto mt-7 max-w-[56ch] text-center">
                  <h3 class="font-display text-[22px] leading-snug font-semibold tracking-[-0.015em]">{s.title}</h3>
                  <p class="mt-2.5 text-[15.5px] leading-[1.6] text-ink-2">{s.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SERVICES -->
      <section id="services" class="scroll-mt-24 pt-28 sm:pt-40">
        <div class="mx-auto max-w-[48ch] text-center">
          <p class="eyebrow reveal">What it takes off your hands</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-[clamp(2.125rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
            The things that eat your day
          </h2>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <article class:list={['card card-lift reveal overflow-hidden', `reveal-d${(i % 3) + 1}`]}>
              <figure class="media aspect-[4/3]" style={`background-image:url("${lqip[s.img]}")`}>
                <img
                  src={`/img/${s.img}-${s.w}.webp`}
                  srcset={s.w === 1600
                    ? `/img/${s.img}-960.webp 960w, /img/${s.img}-1600.webp 1600w`
                    : `/img/${s.img}-640.webp 640w, /img/${s.img}-1000.webp 1000w`}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt={s.alt}
                  width={s.w} height={Math.round(s.w * 0.75)}
                  loading="lazy"
                  data-fade
                />
              </figure>
              <div class="p-7">
                <h3 class="font-display text-[20px] leading-snug font-semibold tracking-[-0.015em]">{s.title}</h3>
                <p class="mt-2.5 text-[15px] leading-[1.6] text-ink-2">{s.body}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- TWO AUDIENCES -->
      <section class="pt-28 sm:pt-40">
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="card reveal p-8 sm:p-10">
            <p class="eyebrow">For the clinic</p>
            <h2 class="mt-4 font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.1] font-semibold tracking-[-0.025em]">
              Runs the way your day runs
            </h2>
            <ul class="mt-7 flex flex-col gap-4">
              {forClinics.map((p) => (
                <li class="flex items-start gap-3.5">
                  <span class="tooth-marker mt-1 text-accent"></span>
                  <span class="text-[15.5px] leading-[1.55]">{p}</span>
                </li>
              ))}
            </ul>
            <a href="/clinics/" class="btn btn-primary mt-9">Open a demo clinic</a>
          </div>

          <div class="card reveal reveal-d1 overflow-hidden">
            <figure class="media aspect-[16/9]" style={`background-image:url("${lqip.operatory}")`}>
              <img
                src="/img/operatory-1600.webp"
                srcset="/img/operatory-960.webp 960w, /img/operatory-1600.webp 1600w"
                sizes="(min-width: 1024px) 50vw, 100vw"
                alt="A calm modern dental operatory with a treatment chair and overhead light"
                width="1600" height="900" loading="lazy" data-fade
              />
            </figure>
            <div class="p-8 sm:p-10">
              <p class="eyebrow">For your patients</p>
              <h2 class="mt-4 font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.1] font-semibold tracking-[-0.025em]">
                Less waiting, less paperwork
              </h2>
              <ul class="mt-7 flex flex-col gap-4">
                {forPatients.map((p) => (
                  <li class="flex items-start gap-3.5">
                    <span class="tooth-marker mt-1 text-accent"></span>
                    <span class="text-[15.5px] leading-[1.55]">{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="scroll-mt-24 pt-28 sm:pt-40">
        <div class="mx-auto max-w-[46ch] text-center">
          <p class="eyebrow reveal">Questions</p>
          <h2 class="reveal reveal-d1 mt-4 font-display text-[clamp(2.125rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
            Things people ask us
          </h2>
        </div>
        <div class="reveal mx-auto mt-12 max-w-[740px]">
          {faqs.map((f, i) => (
            <details class="group py-1">
              {i > 0 && <hr class="rule" />}
              <summary class="flex cursor-pointer items-center justify-between gap-5 py-5 text-[17.5px] font-semibold tracking-[-0.01em] transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 group-open:rotate-45 group-open:border-accent group-open:text-accent">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </span>
              </summary>
              <p class="max-w-[62ch] pb-6 text-[15.5px] leading-[1.65] text-ink-2">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="pt-28 sm:pt-40">
        <div class="reveal relative overflow-hidden rounded-[32px] bg-[#143b3c] px-8 py-20 text-center text-[#eef5f2] sm:px-14">
          <span
            class="pointer-events-none absolute -top-28 left-1/2 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-[#7fd2bd]/14 blur-3xl"
            aria-hidden="true"
          ></span>
          <div class="relative">
            <span class="tooth-marker tooth-marker-lg mx-auto mb-7 block text-[#7fd2bd]"></span>
            <h2 class="mx-auto max-w-[19ch] font-display text-[clamp(2.125rem,4.5vw,3.125rem)] leading-[1.06] font-semibold tracking-[-0.03em] text-[#f4faf7]">
              Open a clinic and click around
            </h2>
            <p class="mx-auto mt-6 max-w-[48ch] text-[17.5px] leading-[1.6] text-[#b8d4cc]">
              No form, no call, no waiting on a reply. If it is not right for your clinic we would
              rather you found out in the next five minutes than in three months.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-3.5">
              <a href="/clinics/" class="btn bg-[#7fd2bd] text-[#0d2a2b] hover:bg-[#9ee0cf]">Open a demo clinic</a>
              <a href="#faq" class="btn border-[#eef5f2]/25 bg-[#eef5f2]/5 text-[#eef5f2] hover:border-[#7fd2bd] hover:text-[#7fd2bd]">
                Talk to a person first
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="mx-auto mt-28 max-w-[1180px] px-5 pb-16 sm:px-8">
    <hr class="rule" />
    <div class="grid gap-10 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <span class="tooth-marker"></span>
          </span>
          <span class="font-display text-[19px] font-bold tracking-[-0.02em]">Flossify</span>
        </div>
        <p class="mt-4 max-w-[34ch] text-[15px] leading-[1.6] text-muted">
          Dental clinic software. Built by Brylliant Labs in Baguio City, Philippines.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11.5px] font-semibold tracking-[0.11em] text-faint uppercase">Product</span>
        <a href="#product" class="text-[15px] text-ink-2 transition-colors hover:text-accent">See it</a>
        <a href="#services" class="text-[15px] text-ink-2 transition-colors hover:text-accent">What it does</a>
        <a href="/clinics/" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Clinic sign in</a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11.5px] font-semibold tracking-[0.11em] text-faint uppercase">Company</span>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">About</a>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Contact</a>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Security</a>
      </div>
    </div>
    <p class="mt-14 text-[13px] text-faint">© 2026 Brylliant Labs, Inc.</p>
  </footer>
</Base>

<script>
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* storage blocked: the toggle still works for this page view */
    }
  });

  // Blur-up. `complete` covers cached images, which never fire load.
  document.querySelectorAll<HTMLImageElement>('img[data-fade]').forEach((img) => {
    if (img.complete) img.classList.add('is-loaded');
    else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
  });

  // Reveal once on entry; never animate back out on the way up.
  const revealables = document.querySelectorAll('.reveal');
  if (reduced || !('IntersectionObserver' in window)) {
    revealables.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          obs.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    revealables.forEach((el) => io.observe(el));
  }

  // Product tabs, with the arrow-key behaviour a tablist is supposed to have.
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = buttons.map((b) =>
      document.getElementById(b.getAttribute('aria-controls')!)
    );

    const select = (i: number, focus = false) => {
      buttons.forEach((b, j) => {
        const on = i === j;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const panel = panels[j];
        if (!panel) return;
        if (on) {
          panel.hidden = false;
          requestAnimationFrame(() => panel.classList.add('is-shown'));
        } else {
          panel.classList.remove('is-shown');
          panel.hidden = true;
        }
      });
      if (focus) buttons[i].focus();
    };

    buttons.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select((i + step + buttons.length) % buttons.length, true);
      });
    });
  }
</script>
