---
import Base from '../layouts/Base.astro';
import ClinicScene from '../components/ClinicScene.astro';

// Four acts, one per camera stop. Each begins as the camera arrives.
const acts = [
  {
    eyebrow: 'Walk in',
    title: 'Everything your clinic does, in one calm place.',
    body: 'Scroll, and you will walk through a clinic the way a patient does. Everything we make is for the people inside it — the ones on their feet all day.',
    points: [],
    align: 'center',
  },
  {
    eyebrow: 'The front desk',
    title: 'Nobody hunting for a folder',
    body: 'Your receptionist opens the day and it is already laid out. Who has arrived, who is waiting, who is running late.',
    points: [
      'Patients arrive already checked in, having filled their history at home',
      'Every record opens in one tap, from any device at the desk',
      'The queue updates itself as people move through',
    ],
    align: 'left',
  },
  {
    eyebrow: 'Booking',
    title: 'No more phone tag',
    body: 'Booking the next visit happens before the patient stands up, and the reminder goes out without anyone remembering to send it.',
    points: [
      'Rebook from the chair in two taps',
      'Friendly reminders the night before, and again when a cleaning is due',
      'Consent and forms signed on the patient’s own phone',
    ],
    align: 'right',
  },
  {
    eyebrow: 'Chairside',
    title: 'Built for gloved hands',
    body: 'The part that matters. Big targets, no tiny menus, nothing that needs a second person typing while you work.',
    points: [
      'Chart a tooth and its surfaces without leaving the chair',
      'Photos and X-rays land straight on the record',
      'The receipt is ready before the patient reaches the desk',
    ],
    align: 'left',
  },
];

const settling = [
  {
    n: '01',
    title: 'We bring your records across',
    body: 'Another system, a spreadsheet, a shelf of index cards. You send it, we move it, and we do not charge for it.',
  },
  {
    n: '02',
    title: 'We set it up with you',
    body: 'Your procedures, your prices, your forms, your staff logins. Sat down together, not left as homework.',
  },
  {
    n: '03',
    title: 'A person answers',
    body: 'When something breaks, you reach someone who knows your clinic. Not a ticket number.',
  },
];

const faqs = [
  {
    q: 'Do I need to be good with computers?',
    a: 'No. If you can use a phone, you can use this. The parts you touch every day are the ones we worked hardest to make obvious, and we will sit with you for the first week.',
  },
  {
    q: 'I already use something else. Is moving painful?',
    a: 'It is our job, not yours. Send us whatever you have and we bring the patients, charts and balances across while you carry on working.',
  },
  {
    q: 'What happens to my records if I ever leave?',
    a: 'You take everything with you, in a format you can open without us. No exit fee. They were always yours.',
  },
  {
    q: 'Does it work when the internet is down?',
    a: 'Charting, notes and your schedule run on the device in front of you, and catch up quietly when the connection returns. Messages and card payments do need a signal, and the app is honest about which is which.',
  },
  {
    q: 'Who is behind it?',
    a: 'A small team in Baguio City. You talk to the people who build it, which is why things get fixed quickly.',
  },
];
---

<Base
  title="Flossify — calm software for dental clinics"
  description="Walk through a clinic as you scroll. Records, charting, booking and payments, built for the people on their feet all day."
>
  <header class="fixed top-0 right-0 left-0 z-40 border-b border-line-2 bg-bg/75 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
      <a href="/" class="group flex items-center gap-2.5" aria-label="Flossify, home">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-surface">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
            <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
            <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
          </svg>
        </span>
        <span class="font-display text-[21px] leading-none font-bold tracking-[-0.02em]">Flossify</span>
      </a>

      <nav class="flex items-center gap-1.5 sm:gap-3" aria-label="Main">
        <a href="#settling" class="hidden rounded-full px-3.5 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:bg-bg-soft hover:text-ink sm:inline-block">
          Getting started
        </a>
        <a href="#faq" class="hidden rounded-full px-3.5 py-2 text-[14.5px] font-medium text-ink-2 transition-colors hover:bg-bg-soft hover:text-ink sm:inline-block">
          Questions
        </a>
        <button
          type="button"
          data-theme-toggle
          class="ml-1 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-line text-ink-2 transition-colors hover:border-accent hover:text-accent"
          aria-label="Switch between light and dark theme"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"></path>
          </svg>
        </button>
        <a href="/clinics/" class="btn btn-quiet px-5 py-2.5 text-[14.5px]">Clinic sign in</a>
      </nav>
    </div>
  </header>

  <!-- Act indicator: four screens of scroll with no chrome is disorienting. -->
  <nav
    data-acts
    class="pointer-events-none fixed top-1/2 right-5 z-30 hidden -translate-y-1/2 flex-col gap-3 lg:flex"
    aria-label="Walkthrough progress"
  >
    {acts.map((a, i) => (
      <span class="flex items-center gap-2.5" data-act-dot={i}>
        <span class="act-label text-[11px] font-semibold tracking-[0.08em] text-muted uppercase opacity-0 transition-opacity duration-300">
          {a.eyebrow}
        </span>
        <span class="act-dot h-2 w-2 rounded-full bg-line transition-all duration-300"></span>
      </span>
    ))}
  </nav>

  <main id="main">
    <ClinicScene>
      {acts.map((act) => (
        <section
          class:list={[
            'flex h-[100svh] px-5 sm:px-8',
            act.align === 'center' ? 'items-end pb-14 sm:pb-20' : 'items-center',
          ]}
        >
          <div
            class:list={[
              'act-panel w-full rounded-[28px] p-7 sm:p-10',
              act.align === 'center' && 'is-centred mx-auto max-w-[44rem] text-center',
              act.align === 'left' && 'max-w-[35rem] lg:mr-auto lg:ml-[max(2rem,calc(50vw-35rem))]',
              act.align === 'right' && 'max-w-[35rem] lg:mr-[max(2rem,calc(50vw-35rem))] lg:ml-auto',
            ]}
          >
            <p class="eyebrow">{act.eyebrow}</p>
            <h2 class="mt-4 font-display text-[clamp(2.125rem,5vw,3.375rem)] leading-[1.04] font-semibold tracking-[-0.032em]">
              {act.title}
            </h2>
            <p class="mt-5 max-w-[46ch] text-[clamp(1rem,1.4vw,1.1875rem)] leading-[1.6] text-ink-2">
              {act.align === 'center' ? <span class="mx-auto block">{act.body}</span> : act.body}
            </p>
            {act.points.length > 0 && (
              <ul class="mt-7 flex flex-col gap-3.5">
                {act.points.map((p) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 12.5l5 5L20 6.5"></path>
                      </svg>
                    </span>
                    <span class="text-[15.5px] leading-[1.55]">{p}</span>
                  </li>
                ))}
              </ul>
            )}
            {act.align === 'center' && (
              <p class="mt-9 flex items-center justify-center gap-2 text-[13.5px] text-muted">
                Keep scrolling — the clinic comes to you
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 5v14M6 13l6 6 6-6"></path>
                </svg>
              </p>
            )}
          </div>
        </section>
      ))}
    </ClinicScene>

    <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
      <!-- GETTING STARTED -->
      <section id="settling" class="scroll-mt-24 pt-28 sm:pt-40">
        <div class="mx-auto max-w-[46ch] text-center">
          <p class="eyebrow">Getting started</p>
          <h2 class="mt-4 font-display text-[clamp(2.125rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
            Moving in is our job
          </h2>
          <p class="mt-5 text-[17.5px] leading-[1.6] text-ink-2">
            Changing systems is the scary part. So we do it, not you.
          </p>
        </div>
        <div class="mt-14 grid gap-5 lg:grid-cols-3">
          {settling.map((s) => (
            <div class="card card-lift p-8">
              <span class="font-display text-[15px] font-bold tracking-[0.08em] text-accent">{s.n}</span>
              <h3 class="mt-4 font-display text-[21px] leading-snug font-semibold tracking-[-0.015em]">
                {s.title}
              </h3>
              <p class="mt-3 text-[15.5px] leading-[1.6] text-ink-2">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="scroll-mt-24 pt-28 sm:pt-40">
        <div class="mx-auto max-w-[46ch] text-center">
          <p class="eyebrow">Questions</p>
          <h2 class="mt-4 font-display text-[clamp(2.125rem,4.5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.03em]">
            Things people ask us
          </h2>
        </div>
        <div class="mx-auto mt-12 max-w-[740px]">
          {faqs.map((f, i) => (
            <details class="group py-1">
              {i > 0 && <hr class="rule" />}
              <summary class="flex cursor-pointer items-center justify-between gap-5 py-5 text-[17.5px] font-semibold tracking-[-0.01em] transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-all group-open:rotate-45 group-open:border-accent group-open:text-accent">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </span>
              </summary>
              <p class="max-w-[62ch] pb-6 text-[15.5px] leading-[1.65] text-ink-2">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="pt-28 sm:pt-40">
        <div class="relative overflow-hidden rounded-[32px] bg-invert-bg px-8 py-20 text-center text-invert-ink sm:px-14">
          <span
            class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[38rem] -translate-x-1/2 rounded-full bg-accent/12 blur-3xl"
            aria-hidden="true"
          ></span>
          <div class="relative">
            <h2 class="mx-auto max-w-[18ch] font-display text-[clamp(2.125rem,4.5vw,3.125rem)] leading-[1.06] font-semibold tracking-[-0.03em] text-invert-ink">
              Come and have a proper look around
            </h2>
            <p class="mx-auto mt-6 max-w-[48ch] text-[17.5px] leading-[1.6] text-invert-ink-2">
              Poke at it for as long as you like. If it is not right for your clinic, we would
              honestly rather you found out now than three months in.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-3.5">
              <a href="/clinics/" class="btn btn-primary">Have a look around</a>
              <a
                href="#faq"
                class="btn border-invert-ink/25 bg-invert-ink/5 text-invert-ink hover:border-accent hover:bg-accent/10 hover:text-accent"
              >
                Talk to a person first
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="mx-auto mt-28 max-w-[1180px] px-5 pb-16 sm:px-8">
    <hr class="rule" />
    <div class="grid gap-10 pt-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
              <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
              <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
            </svg>
          </span>
          <span class="font-display text-[19px] font-bold tracking-[-0.02em]">Flossify</span>
        </div>
        <p class="mt-4 max-w-[34ch] text-[15px] leading-[1.6] text-muted">
          Calm software for dental clinics. Built by Brylliant Labs in Baguio City, Philippines.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11.5px] font-semibold tracking-[0.11em] text-faint uppercase">Product</span>
        <a href="#settling" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Getting started</a>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Questions</a>
        <a href="/clinics/" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Clinic sign in</a>
      </div>
      <div class="flex flex-col gap-3">
        <span class="text-[11.5px] font-semibold tracking-[0.11em] text-faint uppercase">Company</span>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">About</a>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Contact</a>
        <a href="#faq" class="text-[15px] text-ink-2 transition-colors hover:text-accent">Security</a>
      </div>
    </div>
    <p class="mt-14 text-[13px] text-faint">© 2026 Brylliant Labs, Inc.</p>
  </footer>
</Base>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* storage blocked: the toggle still works for this page view */
    }
  });

  // Act indicator. Driven by the same scroll position as the camera, so the
  // dot and the room always agree about which act you are in.
  const rail = document.querySelector('[data-acts]');
  const scene = document.querySelector('[data-scene]');
  if (rail && scene) {
    const dots = [...rail.querySelectorAll('[data-act-dot]')];
    const update = () => {
      const span = scene.offsetHeight - innerHeight;
      const t = span > 0 ? Math.min(1, Math.max(0, -scene.getBoundingClientRect().top / span)) : 0;
      const past = scene.getBoundingClientRect().bottom < innerHeight * 0.5;
      rail.style.opacity = past ? '0' : '1';
      const active = Math.min(dots.length - 1, Math.round(t * (dots.length - 1)));
      dots.forEach((d, i) => {
        const dot = d.querySelector('.act-dot');
        const label = d.querySelector('.act-label');
        const on = i === active;
        if (dot instanceof HTMLElement) {
          dot.style.background = on ? 'var(--c-accent)' : 'var(--c-line)';
          dot.style.width = on ? '22px' : '8px';
        }
        if (label instanceof HTMLElement) label.style.opacity = on ? '1' : '0';
      });
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
