---
import Base from '../layouts/Base.astro';
import ClinicScene from '../components/ClinicScene.astro';

// Four acts, one per camera stop. Each begins as the camera arrives.
const acts = [
  {
    eyebrow: 'Walk in',
    title: 'Everything your clinic does, in one calm place.',
    body: 'Scroll, and you will walk through a clinic the way a patient does. Everything we make is for the people inside it — the ones on their feet all day.',
    points: [],
    align: 'center',
  },
  {
    eyebrow: 'The front desk',
    title: 'Nobody hunting for a folder',
    body: 'Your receptionist opens the day and it is already laid out. Who has arrived, who is waiting, who is running late.',
    points: [
      'Patients arrive already checked in, having filled their history at home',
      'Every record opens in one tap, from any device at the desk',
      'The queue updates itself as people move through',
    ],
    align: 'left',
  },
  {
    eyebrow: 'Booking',
    title: 'No more phone tag',
    body: 'Booking the next visit happens before the patient stands up, and the reminder goes out without anyone remembering to send it.',
    points: [
      'Rebook from the chair in two taps',
      'Friendly reminders the night before, and again when a cleaning is due',
      'Consent and forms signed on the patient’s own phone',
    ],
    align: 'right',
  },
  {
    eyebrow: 'Chairside',
    title: 'Built for gloved hands',
    body: 'The part that matters. Big targets, no tiny menus, nothing that needs a second person typing while you work.',
    points: [
      'Chart a tooth and its surfaces without leaving the chair',
      'Photos and X-rays land straight on the record',
      'The receipt is ready before the patient reaches the desk',
    ],
    align: 'left',
  },
];

const settling = [
  {
    title: 'We bring your records across',
    body: 'Another system, a spreadsheet, a shelf of index cards. You send it, we move it, and we do not charge for it.',
  },
  {
    title: 'We set it up with you',
    body: 'Your procedures, your prices, your forms, your staff logins. Sat down together, not left as homework.',
  },
  {
    title: 'A person answers',
    body: 'When something breaks, you reach someone who knows your clinic. Not a ticket number.',
  },
];

const faqs = [
  {
    q: 'Do I need to be good with computers?',
    a: 'No. If you can use a phone, you can use this. The parts you touch every day are the ones we worked hardest to make obvious, and we will sit with you for the first week.',
  },
  {
    q: 'I already use something else. Is moving painful?',
    a: 'It is our job, not yours. Send us whatever you have and we bring the patients, charts and balances across while you carry on working.',
  },
  {
    q: 'What happens to my records if I ever leave?',
    a: 'You take everything with you, in a format you can open without us. No exit fee. They were always yours.',
  },
  {
    q: 'Does it work when the internet is down?',
    a: 'Charting, notes and your schedule run on the device in front of you, and catch up quietly when the connection returns. Messages and card payments do need a signal, and the app is honest about which is which.',
  },
  {
    q: 'Who is behind it?',
    a: 'A small team in Baguio City. You talk to the people who build it, which is why things get fixed quickly.',
  },
];
---

<Base
  title="Flossify — calm software for dental clinics"
  description="Walk through a clinic as you scroll. Records, charting, booking and payments, built for the people on their feet all day."
>
  <header class="fixed top-0 right-0 left-0 z-40 border-b border-line-2 bg-bg/80 backdrop-blur">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-5 py-4 sm:px-8">
      <a href="/" class="flex items-center gap-2.5" aria-label="Flossify, home">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" class="text-accent" aria-hidden="true">
          <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
          <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
          <circle cx="12.5" cy="19.5" r="1.7" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="font-display text-[23px] font-bold tracking-tight">Flossify</span>
      </a>
      <nav class="flex items-center gap-4 sm:gap-6" aria-label="Main">
        <a href="#settling" class="hidden text-sm font-medium text-ink-2 hover:text-accent sm:inline">Getting started</a>
        <a href="#faq" class="hidden text-sm font-medium text-ink-2 hover:text-accent sm:inline">Questions</a>
        <button
          type="button"
          data-theme-toggle
          class="cursor-pointer rounded-full border border-line p-2 text-ink-2 hover:border-accent hover:text-accent"
          aria-label="Switch between light and dark theme"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"></path>
          </svg>
        </button>
        <a href="/clinics/" class="rounded-full border border-line px-4 py-2.5 text-sm font-semibold text-ink-2 hover:border-accent hover:text-accent">
          Clinic sign in
        </a>
      </nav>
    </div>
  </header>

  <main id="main">
    <ClinicScene>
      {acts.map((act) => (
        <section
          class:list={[
            'flex h-[100svh] px-5 sm:px-8',
            // The opening act sits low so the shopfront reads above it.
            act.align === 'center' ? 'items-end pb-14 sm:pb-20' : 'items-center',
          ]}
        >
          <div
            class:list={[
              'act-panel mx-auto w-full rounded-[28px] p-7 sm:p-10',
              act.align === 'center' && 'max-w-[42rem] text-center',
              act.align === 'left' && 'max-w-[34rem] lg:mr-auto lg:ml-[max(2rem,calc(50vw-34rem))]',
              act.align === 'right' && 'max-w-[34rem] lg:mr-[max(2rem,calc(50vw-34rem))] lg:ml-auto',
            ]}
          >
            <p class="text-[13.5px] font-semibold tracking-[0.12em] text-accent uppercase">{act.eyebrow}</p>
            <h2 class="mt-4 font-display text-[clamp(2rem,5vw,3.25rem)] leading-[1.05] font-semibold tracking-[-0.03em]">
              {act.title}
            </h2>
            <p class="mt-5 text-[clamp(1rem,1.5vw,1.1875rem)] leading-relaxed text-ink-2">{act.body}</p>
            {act.points.length > 0 && (
              <ul class="mt-6 flex flex-col gap-3">
                {act.points.map((p) => (
                  <li class="flex items-start gap-3">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-accent" aria-hidden="true">
                      <path d="M4 12.5l5 5L20 6.5"></path>
                    </svg>
                    <span class="text-[15.5px] leading-relaxed">{p}</span>
                  </li>
                ))}
              </ul>
            )}
            {act.align === 'center' && (
              <p class="mt-8 text-[14px] text-muted">Keep scrolling — the clinic comes to you.</p>
            )}
          </div>
        </section>
      ))}
    </ClinicScene>

    <div class="mx-auto max-w-[1180px] px-5 sm:px-8">
      <!-- GETTING STARTED -->
      <section id="settling" class="scroll-mt-24 pt-24 sm:pt-32">
        <div class="mx-auto max-w-[44ch] text-center">
          <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] leading-tight font-semibold tracking-[-0.025em]">
            Moving in is our job
          </h2>
          <p class="mt-4 text-[17px] leading-relaxed text-ink-2">
            Changing systems is the scary part. So we do it, not you.
          </p>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {settling.map((s) => (
            <div class="rounded-[26px] border border-line bg-surface p-8">
              <h3 class="font-display text-[21px] leading-snug font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="scroll-mt-24 pt-24 sm:pt-32">
        <h2 class="text-center font-display text-[clamp(2rem,4.5vw,2.875rem)] font-semibold tracking-[-0.025em]">
          Things people ask us
        </h2>
        <div class="mx-auto mt-10 max-w-[720px]">
          {faqs.map((f) => (
            <details class="group border-t border-line py-5 last:border-b">
              <summary class="flex cursor-pointer items-center justify-between gap-4 text-[17.5px] font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="shrink-0 text-muted transition-transform group-open:rotate-45" aria-hidden="true">
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </summary>
              <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="pt-24 sm:pt-32">
        <div class="rounded-[32px] bg-invert-bg px-8 py-16 text-center text-invert-ink sm:px-14">
          <h2 class="mx-auto max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3rem)] leading-tight font-semibold tracking-[-0.025em] text-invert-ink">
            Come and have a proper look around
          </h2>
          <p class="mx-auto mt-5 max-w-[46ch] text-[17px] leading-relaxed text-invert-ink-2">
            Poke at it for as long as you like. If it is not right for your clinic, we would
            honestly rather you found out now than three months in.
          </p>
          <div class="mt-9 flex flex-wrap justify-center gap-3.5">
            <a href="/clinics/" class="rounded-full bg-accent px-9 py-4 text-base font-semibold text-surface hover:bg-accent-deep">
              Have a look around
            </a>
            <a href="#faq" class="rounded-full border border-invert-line px-9 py-4 text-base font-semibold">
              Talk to a person first
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="mx-auto mt-20 max-w-[1180px] px-5 pb-14 sm:px-8">
    <div class="flex flex-col justify-between gap-8 border-t border-line pt-8 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2.5">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-accent" aria-hidden="true">
          <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
          <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="font-display text-[19px] font-bold">Flossify</span>
      </div>
      <nav class="flex flex-wrap gap-x-7 gap-y-3" aria-label="Footer">
        <a href="#settling" class="text-[14.5px] text-ink-2 hover:text-accent">Getting started</a>
        <a href="#faq" class="text-[14.5px] text-ink-2 hover:text-accent">Questions</a>
        <a href="/clinics/" class="text-[14.5px] text-ink-2 hover:text-accent">Clinic sign in</a>
      </nav>
    </div>
    <p class="mt-7 text-[13px] text-faint">
      Flossify is built by Brylliant Labs in Baguio City, Philippines.
    </p>
  </footer>
</Base>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* storage blocked: the toggle still works for this page view */
    }
  });
</script>
