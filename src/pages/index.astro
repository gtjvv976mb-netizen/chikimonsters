---
import Base from '../layouts/Base.astro';
import Odontogram from '../components/Odontogram.astro';

// Services, described the way a dentist would say them out loud. No numbers,
// no competitor columns -- what the clinic gets, in plain words.
const services = [
  {
    title: 'Everything about a patient, in one place',
    body: 'History, notes, photos, X-rays, what they had done and what they still owe. No more hunting through a folder while someone waits.',
    icon: 'folder',
  },
  {
    title: 'Charting that keeps up with you',
    body: 'Tap a tooth, pick the surfaces, pick the finding. It reads back the way you would write it, so your notes still make sense next year.',
    icon: 'tooth',
  },
  {
    title: 'A day that runs on time',
    body: 'See who has arrived, who is waiting, and who is in the chair. The front desk stops asking you, and you stop asking them.',
    icon: 'clock',
  },
  {
    title: 'Reminders that bring people back',
    body: 'A friendly message before the appointment, and another when a cleaning is due. Quietly, in the background, without anyone remembering to send it.',
    icon: 'bell',
  },
  {
    title: 'Paperwork that fills itself in',
    body: 'Consent forms, certificates, clearances, prescriptions. The details you already have get filled in for you, and patients can sign on their own phone.',
    icon: 'pen',
  },
  {
    title: 'Money, without the headache',
    body: 'Proper receipts, what each patient owes, and what the HMOs still have not paid you. All in one view you can actually read.',
    icon: 'peso',
  },
  {
    title: 'Keeps working when the power does not',
    body: 'Brownout, storm, or a dead connection — you keep charting. Everything catches up on its own once things come back.',
    icon: 'offline',
  },
  {
    title: 'More than one branch? No problem',
    body: 'Each branch runs its own day. You see all of them together whenever you want to.',
    icon: 'branches',
  },
];

const day = [
  {
    when: 'Before you open',
    body: 'Today is already laid out. Anyone who needed reminding got a message last night.',
  },
  {
    when: 'First patient',
    body: 'They filled in their history at home, on their phone. It is waiting for you, already typed up.',
  },
  {
    when: 'Mid-morning',
    body: 'You chart as you work. Two taps a tooth, and the note writes itself in the language you would have used.',
  },
  {
    when: 'After lunch',
    body: 'Someone cancels. The slot goes back out, and the afternoon fills itself in.',
  },
  {
    when: 'Closing up',
    body: 'Receipts are done, the day adds up, and you go home. Nothing to reconcile tonight.',
  },
];

const settling = [
  {
    title: 'We bring your records across',
    body: 'Whatever you are on now — another system, a spreadsheet, a shelf of index cards. You send it, we move it, and we do not charge for it.',
  },
  {
    title: 'We set it up with you',
    body: 'Your procedures, your prices, your forms, your staff logins. Sat down together, not left as homework.',
  },
  {
    title: 'A person answers',
    body: 'When something breaks or you cannot find a thing, you reach someone who knows your clinic. Not a ticket number.',
  },
];

const faqs = [
  {
    q: 'Do I need to be good with computers?',
    a: 'No. If you can use a phone, you can use this. The parts you touch every day are the ones we worked hardest to make obvious, and we will sit with you for the first week.',
  },
  {
    q: 'I already use something else. Is moving painful?',
    a: 'It is our job, not yours. Send us whatever you have and we bring the patients, charts and balances across. You carry on working while we do it.',
  },
  {
    q: 'What happens to my records if I ever leave?',
    a: 'You take everything with you, in a format you can open without us. No exit fee, no holding your records hostage. They were always yours.',
  },
  {
    q: 'Does it really work without internet?',
    a: 'Charting, notes and your schedule run on the device in front of you. When the connection comes back, everything catches up quietly. Messages and card payments do need a signal, and the app is honest with you about which is which.',
  },
  {
    q: 'Who is behind it?',
    a: 'A small team in Baguio City. You talk to the people who build it, which is the whole reason we are able to fix things quickly.',
  },
];

const nav = [
  { href: '#services', label: 'What it does' },
  { href: '#day', label: 'A normal day' },
  { href: '#settling', label: 'Getting started' },
  { href: '#faq', label: 'Questions' },
];
---

<Base
  title="Flossify — calm software for dental clinics"
  description="Everything your clinic does, in one calm place. Patient records, charting, appointments, reminders, paperwork and payments — built to be kind to the people using it."
>
  <header class="sticky top-0 z-40 border-b border-line-2 bg-bg/85 backdrop-blur">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-5 py-4 sm:px-8">
      <a href="/" class="flex items-center gap-2.5" aria-label="Flossify, home">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" class="text-accent" aria-hidden="true">
          <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
          <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
          <circle cx="12.5" cy="19.5" r="1.7" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="font-display text-[23px] font-bold tracking-tight">Flossify</span>
      </a>

      <nav class="flex items-center gap-5 sm:gap-7" aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} class="hidden text-sm font-medium text-ink-2 hover:text-accent lg:inline">{n.label}</a>
        ))}
        <button
          type="button"
          data-theme-toggle
          class="cursor-pointer rounded-full border border-line p-2 text-ink-2 hover:border-accent hover:text-accent"
          aria-label="Switch between light and dark theme"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z"></path>
          </svg>
        </button>
        <a href="/clinics/" class="rounded-full border border-line px-4 py-2.5 text-sm font-semibold text-ink-2 hover:border-accent hover:text-accent">
          Clinic sign in
        </a>
      </nav>
    </div>
  </header>

  <main id="main" class="mx-auto max-w-[1180px] px-5 sm:px-8">
    <!-- HERO -->
    <section class="pt-16 pb-4 text-center sm:pt-24">
      <p class="text-[14.5px] font-semibold tracking-wide text-accent">Made in Baguio, for dental clinics</p>
      <h1 class="mx-auto mt-5 max-w-[15ch] font-display text-[clamp(2.5rem,7vw,4.25rem)] leading-[1.03] font-semibold tracking-[-0.03em]">
        Everything your clinic does, in one calm place.
      </h1>
      <p class="mx-auto mt-6 max-w-[54ch] text-[clamp(1.0625rem,1.6vw,1.25rem)] leading-relaxed text-ink-2">
        Have a go at the chart below. No sign-up, no sales call, nothing to install —
        that is rather the point.
      </p>
    </section>

    <section class="pt-8">
      <Odontogram />
      <p class="mt-5 text-center text-[15px] text-muted">
        That is the real thing, not a picture of it. Click any tooth.
      </p>
    </section>

    <!-- SERVICES -->
    <section id="services" class="scroll-mt-24 pt-24 sm:pt-32">
      <div class="mx-auto max-w-[44ch] text-center">
        <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] leading-tight font-semibold tracking-[-0.025em]">
          What it takes off your hands
        </h2>
        <p class="mt-4 text-[17px] leading-relaxed text-ink-2">
          Not a list of features. The things that eat your day, done for you.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {services.map((s) => (
          <li class="rounded-[26px] border border-line bg-surface p-7 sm:p-8">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {s.icon === 'folder' && <path d="M3 7.5a2 2 0 0 1 2-2h4l2 2.5h8a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />}
                {s.icon === 'tooth' && <path d="M8 3.5c-2.2 0-3.5 1.6-3.5 3.8 0 3 1.4 4 1.9 7.4.3 2.1.5 5.3 1.9 5.3 1.6 0 1.3-4.8 3.7-4.8s2.1 4.8 3.7 4.8c1.4 0 1.6-3.2 1.9-5.3.5-3.4 1.9-4.4 1.9-7.4 0-2.2-1.3-3.8-3.5-3.8-1.8 0-2.6 1-4 1-1.4 0-2.2-1-4-1Z" />}
                {s.icon === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
                {s.icon === 'bell' && <><path d="M6 10a6 6 0 1 1 12 0c0 3.5 1.2 5 1.2 5H4.8S6 13.5 6 10Z" /><path d="M10 19a2 2 0 0 0 4 0" /></>}
                {s.icon === 'pen' && <><path d="M4 20h4L19 9a2.5 2.5 0 0 0-3.5-3.5L4.5 16.5Z" /><path d="M14.5 6.5 17.5 9.5" /></>}
                {s.icon === 'peso' && <><path d="M8 19V5h4.5a4 4 0 0 1 0 8H8" /><path d="M6 9h9M6 12h9" /></>}
                {s.icon === 'offline' && <><path d="M5 12.5a7 7 0 0 1 11-3" /><path d="M8 16a4 4 0 0 1 5.5-2" /><circle cx="12" cy="19" r="0.6" fill="currentColor" /><path d="M4 4l16 16" /></>}
                {s.icon === 'branches' && <><circle cx="12" cy="5" r="2.2" /><circle cx="5.5" cy="18.5" r="2.2" /><circle cx="18.5" cy="18.5" r="2.2" /><path d="M12 7.2v3.3M12 10.5H5.5v5.8M12 10.5h6.5v5.8" /></>}
              </svg>
            </span>
            <h3 class="mt-5 font-display text-[22px] leading-snug font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2.5 text-[15.5px] leading-relaxed text-ink-2">{s.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- A NORMAL DAY -->
    <section id="day" class="scroll-mt-24 pt-24 sm:pt-32">
      <div class="rounded-[32px] bg-bg-soft px-6 py-14 sm:px-14">
        <div class="mx-auto max-w-[42ch] text-center">
          <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] leading-tight font-semibold tracking-[-0.025em]">
            What a normal day looks like
          </h2>
          <p class="mt-4 text-[17px] leading-relaxed text-ink-2">
            Nothing dramatic. That is the nicest thing we can say about it.
          </p>
        </div>

        <ol class="mx-auto mt-12 max-w-[640px]">
          {day.map((d, i) => (
            <li class="flex gap-5 pb-9 last:pb-0">
              <div class="flex flex-col items-center">
                <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-accent"></span>
                {i < day.length - 1 && <span class="mt-1.5 w-px flex-1 bg-line"></span>}
              </div>
              <div class="pb-1">
                <h3 class="font-display text-[19px] font-semibold">{d.when}</h3>
                <p class="mt-1.5 text-[15.5px] leading-relaxed text-ink-2">{d.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- GETTING STARTED -->
    <section id="settling" class="scroll-mt-24 pt-24 sm:pt-32">
      <div class="mx-auto max-w-[44ch] text-center">
        <h2 class="font-display text-[clamp(2rem,4.5vw,2.875rem)] leading-tight font-semibold tracking-[-0.025em]">
          Moving in is our job
        </h2>
        <p class="mt-4 text-[17px] leading-relaxed text-ink-2">
          Changing systems is the scary part. So we do it, not you.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {settling.map((s) => (
          <div class="rounded-[26px] border border-line bg-surface p-8">
            <h3 class="font-display text-[21px] leading-snug font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-24 pt-24 sm:pt-32">
      <h2 class="text-center font-display text-[clamp(2rem,4.5vw,2.875rem)] font-semibold tracking-[-0.025em]">
        Things people ask us
      </h2>
      <div class="mx-auto mt-10 max-w-[720px]">
        {faqs.map((f) => (
          <details class="group border-t border-line py-5 last:border-b">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-[17.5px] font-semibold [&::-webkit-details-marker]:hidden">
              {f.q}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="shrink-0 text-muted transition-transform group-open:rotate-45" aria-hidden="true">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <p class="mt-3 text-[15.5px] leading-relaxed text-ink-2">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="pt-24 sm:pt-32">
      <div class="rounded-[32px] bg-invert-bg px-8 py-16 text-center text-invert-ink sm:px-14">
        <h2 class="mx-auto max-w-[18ch] font-display text-[clamp(2rem,4.5vw,3rem)] leading-tight font-semibold tracking-[-0.025em] text-invert-ink">
          Come and have a proper look around
        </h2>
        <p class="mx-auto mt-5 max-w-[46ch] text-[17px] leading-relaxed text-invert-ink-2">
          Poke at it for as long as you like. If it is not right for your clinic, we would
          honestly rather you found out now than three months in.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3.5">
          <a href="/clinics/" class="rounded-full bg-accent px-9 py-4 text-base font-semibold text-surface hover:bg-accent-deep">
            Have a look around
          </a>
          <a href="#faq" class="rounded-full border border-invert-line px-9 py-4 text-base font-semibold">
            Talk to a person first
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="mx-auto mt-20 max-w-[1180px] px-5 pb-14 sm:px-8">
    <div class="flex flex-col justify-between gap-8 border-t border-line pt-8 sm:flex-row sm:items-center">
      <div class="flex items-center gap-2.5">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-accent" aria-hidden="true">
          <path d="M5.5 4.5c0 6.5 13 4 13 10.5 0 3.2-2.8 5-6 4.5"></path>
          <circle cx="5.5" cy="4.5" r="1.7" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="font-display text-[19px] font-bold">Flossify</span>
      </div>
      <nav class="flex flex-wrap gap-x-7 gap-y-3" aria-label="Footer">
        <a href="#services" class="text-[14.5px] text-ink-2 hover:text-accent">What it does</a>
        <a href="#settling" class="text-[14.5px] text-ink-2 hover:text-accent">Getting started</a>
        <a href="#faq" class="text-[14.5px] text-ink-2 hover:text-accent">Questions</a>
        <a href="/clinics/" class="text-[14.5px] text-ink-2 hover:text-accent">Clinic sign in</a>
      </nav>
    </div>
    <p class="mt-7 text-[13px] text-faint">
      Flossify is built by Brylliant Labs in Baguio City, Philippines.
    </p>
  </footer>
</Base>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* storage blocked: the toggle still works for this page view */
    }
  });
</script>
