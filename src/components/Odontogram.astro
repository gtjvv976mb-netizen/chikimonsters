---
// Full adult dentition, rendered server-side.
// Every tooth is a real <button>; the script cycles a data attribute,
// so the chart is keyboard-operable and legible before any JS runs.
//
// Notation matters for going global: FDI is the international standard
// (and what Philippine schools teach), the US uses Universal 1-32, the UK
// uses Palmer. Same tooth, three names — so each button carries all three
// and the segmented control relabels without re-rendering.

type Tooth = { fdi: number; universal: number; palmer: string };

const QUADRANTS: Record<number, { palmer: string; universalStart: number; ascending: boolean }> = {
  1: { palmer: 'UR', universalStart: 1, ascending: false },  // FDI 18..11 -> US 1..8
  2: { palmer: 'UL', universalStart: 9, ascending: true },   // FDI 21..28 -> US 9..16
  3: { palmer: 'LL', universalStart: 17, ascending: false }, // FDI 38..31 -> US 17..24
  4: { palmer: 'LR', universalStart: 25, ascending: true },  // FDI 41..48 -> US 25..32
};

function tooth(fdi: number): Tooth {
  const q = Math.floor(fdi / 10);
  const pos = fdi % 10;
  const meta = QUADRANTS[q];
  const offset = meta.ascending ? pos - 1 : 8 - pos;
  return { fdi, universal: meta.universalStart + offset, palmer: `${meta.palmer}${pos}` };
}

const upperRight = [18, 17, 16, 15, 14, 13, 12, 11].map(tooth);
const upperLeft = [21, 22, 23, 24, 25, 26, 27, 28].map(tooth);
const lowerRight = [48, 47, 46, 45, 44, 43, 42, 41].map(tooth);
const lowerLeft = [31, 32, 33, 34, 35, 36, 37, 38].map(tooth);

const legend = [
  { label: 'Caries', cls: 'bg-caries' },
  { label: 'Filled', cls: 'bg-accent' },
  { label: 'Crown', cls: 'bg-crown' },
  { label: 'Missing', cls: 'bg-[var(--c-tooth-missing)]' },
];

const notations = [
  { id: 'fdi', label: 'FDI' },
  { id: 'universal', label: 'Universal' },
  { id: 'palmer', label: 'Palmer' },
];
---

<div
  data-odontogram
  data-notation="fdi"
  class="flex flex-col gap-7 rounded-3xl border border-line bg-surface p-6 sm:p-8 lg:flex-row"
>
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <fieldset class="flex items-center gap-2">
        <legend class="sr-only">Tooth notation system</legend>
        {notations.map((n, i) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="notation"
              value={n.id}
              checked={i === 0}
              class="peer sr-only"
              data-notation-input
            />
            <span class="block rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-surface">
              {n.label}
            </span>
          </label>
        ))}
      </fieldset>

      <div class="flex flex-wrap gap-4">
        {legend.map((g) => (
          <span class="flex items-center gap-1.5 text-xs text-ink-2">
            <span class={`swatch ${g.cls}`}></span>{g.label}
          </span>
        ))}
      </div>
    </div>

    <div class="mt-6 flex justify-center gap-4 overflow-x-auto pb-1">
      {[upperRight, upperLeft].map((quadrant) => (
        <div class="flex gap-[5px]">
          {quadrant.map((t) => (
            <div class="flex flex-col items-center gap-1.5">
              <button
                type="button"
                class="tooth"
                data-tooth
                data-state="sound"
                data-fdi={t.fdi}
                data-universal={t.universal}
                data-palmer={t.palmer}
                aria-label={`Tooth ${t.fdi}, currently Sound. Activate to change.`}
              ></button>
              <span class="text-[11px] tabular-nums text-muted" data-label>{t.fdi}</span>
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="my-3.5 flex items-center gap-3.5">
      <div class="h-px flex-1 bg-line-2"></div>
      <span class="text-[11px] tracking-[0.08em] text-faint uppercase">Midline</span>
      <div class="h-px flex-1 bg-line-2"></div>
    </div>

    <div class="flex justify-center gap-4 overflow-x-auto pt-1">
      {[lowerRight, lowerLeft].map((quadrant) => (
        <div class="flex gap-[5px]">
          {quadrant.map((t) => (
            <div class="flex flex-col-reverse items-center gap-1.5">
              <button
                type="button"
                class="tooth tooth--lower"
                data-tooth
                data-state="sound"
                data-fdi={t.fdi}
                data-universal={t.universal}
                data-palmer={t.palmer}
                aria-label={`Tooth ${t.fdi}, currently Sound. Activate to change.`}
              ></button>
              <span class="text-[11px] tabular-nums text-muted" data-label>{t.fdi}</span>
            </div>
          ))}
        </div>
      ))}
    </div>

    <p class="mt-6 text-[13px] text-muted">
      Click a tooth to cycle it: sound, caries, filled, crown, missing.
    </p>
  </div>

  <div class="flex w-full shrink-0 flex-col rounded-2xl border border-line-2 bg-bg-soft p-5 lg:w-[270px]">
    <div class="flex items-baseline justify-between">
      <span class="text-xs font-semibold tracking-[0.1em] text-muted uppercase">Chart note</span>
      <span data-count class="text-xs tabular-nums text-muted"></span>
    </div>

    <p data-note-empty class="mt-3.5 text-sm leading-relaxed text-muted">
      Nothing charted yet. Mark a tooth and it lands here, the way it would in a real patient record.
    </p>

    <ul data-note-list class="mt-3.5 flex flex-col gap-2.5" hidden></ul>

    <div class="min-h-4 flex-1"></div>

    <button
      type="button"
      data-clear
      class="mt-4 w-full cursor-pointer rounded-lg border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent"
    >
      Clear chart
    </button>
  </div>
</div>

<script>
  const STATES = ['sound', 'caries', 'filled', 'crown', 'missing'];
  const LABELS: Record<string, string> = {
    sound: 'Sound',
    caries: 'Caries',
    filled: 'Filled',
    crown: 'Crown',
    missing: 'Missing',
  };
  const SWATCH: Record<string, string> = {
    caries: 'var(--c-caries)',
    filled: 'var(--c-accent)',
    crown: 'var(--c-crown)',
    missing: 'var(--c-tooth-missing)',
  };

  document.querySelectorAll<HTMLElement>('[data-odontogram]').forEach((root) => {
    const teeth = [...root.querySelectorAll<HTMLButtonElement>('button[data-tooth]')];
    const list = root.querySelector<HTMLElement>('[data-note-list]');
    const empty = root.querySelector<HTMLElement>('[data-note-empty]');
    const counter = root.querySelector<HTMLElement>('[data-count]');
    const clear = root.querySelector<HTMLButtonElement>('[data-clear]');
    const marks = new Map<HTMLButtonElement, string>();

    const nameOf = (btn: HTMLButtonElement) =>
      btn.dataset[root.dataset.notation ?? 'fdi'] ?? btn.dataset.fdi!;

    function describe(btn: HTMLButtonElement) {
      const state = marks.get(btn) ?? 'sound';
      btn.setAttribute(
        'aria-label',
        `Tooth ${nameOf(btn)}, currently ${LABELS[state]}. Activate to change.`
      );
    }

    function render() {
      if (!list || !empty || !counter) return;
      const entries = teeth.filter((b) => marks.has(b));
      counter.textContent = entries.length ? `${entries.length} marked` : '';
      empty.hidden = entries.length > 0;
      list.hidden = entries.length === 0;
      list.replaceChildren(
        ...entries.map((btn) => {
          const state = marks.get(btn)!;
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2.5';

          const dot = document.createElement('span');
          dot.className = 'swatch rounded-full';
          dot.style.background = SWATCH[state];

          const num = document.createElement('span');
          num.className = 'min-w-10 text-sm font-semibold tabular-nums';
          num.textContent = nameOf(btn);

          const label = document.createElement('span');
          label.className = 'text-sm text-ink-2';
          label.textContent = LABELS[state];

          li.append(dot, num, label);
          return li;
        })
      );
    }

    teeth.forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = marks.get(btn) ?? 'sound';
        const next = STATES[(STATES.indexOf(current) + 1) % STATES.length];
        if (next === 'sound') marks.delete(btn);
        else marks.set(btn, next);
        btn.dataset.state = next;
        describe(btn);
        render();
      });
    });

    root.querySelectorAll<HTMLInputElement>('[data-notation-input]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        root.dataset.notation = input.value;
        teeth.forEach((btn) => {
          const label = btn.parentElement?.querySelector<HTMLElement>('[data-label]');
          if (label) label.textContent = nameOf(btn);
          describe(btn);
        });
        render();
      });
    });

    clear?.addEventListener('click', () => {
      marks.clear();
      teeth.forEach((btn) => {
        btn.dataset.state = 'sound';
        describe(btn);
      });
      render();
    });

    render();
  });
</script>
