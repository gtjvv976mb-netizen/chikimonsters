---
// A scroll-driven walkthrough. The canvas is pinned while the acts passed in
// through the slot scroll over it; each act begins exactly as the camera
// reaches its stop.
//
// The canvas is decorative: every word is real text in the slot, so the page
// works with WebGL off, JavaScript off, or a screen reader on.
---

<div data-scene class="scene relative">
  <div class="sticky top-0 h-[100svh] w-full">
    <canvas data-scene-canvas class="block h-full w-full" aria-hidden="true"></canvas>
  </div>
  <div class="relative -mt-[100svh]">
    <slot />
  </div>
</div>

<script>
  import { mountClinicScene } from '../scenes/clinic';
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => mountClinicScene(el));
</script>
