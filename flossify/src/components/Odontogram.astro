---
import {
  CONDITION_LABEL, SURFACE_SCOPED, SURFACE_LABEL, occlusalWord, surfaceSummary,
  type ToothCondition, type ToothMark, type Notation, type Surface,
} from '../data/demo';

interface Props {
  /** Existing findings keyed by FDI number. Empty means a fresh chart. */
  marks?: Partial<Record<number, ToothMark>>;
  /** Which numbering to show first. Staff switch it in the control. */
  notation?: Notation;
}

const { marks = {}, notation = 'fdi' } = Astro.props;

// --- notation -------------------------------------------------------------
// FDI is what we store. Universal (US) and Palmer (UK) are display only, so a
// record stays readable wherever it is opened.
const QUADRANTS: Record<number, { palmer: string; universalStart: number; ascending: boolean }> = {
  1: { palmer: 'UR', universalStart: 1, ascending: false },
  2: { palmer: 'UL', universalStart: 9, ascending: true },
  3: { palmer: 'LL', universalStart: 17, ascending: false },
  4: { palmer: 'LR', universalStart: 25, ascending: true },
};

// --- surface geometry -----------------------------------------------------
// Mesial means "toward the midline", so which SIDE of the drawn tooth that is
// depends on the quadrant. Buccal faces the cheek: up for the upper arch,
// down for the lower. Getting this wrong puts the mark on the wrong surface,
// which is a clinical error, not a cosmetic one.
function pips(fdi: number) {
  const q = Math.floor(fdi / 10);
  const upper = q === 1 || q === 2;
  const mesialRight = q === 1 || q === 4;
  return {
    mesial: { x: mesialRight ? 80 : 20, y: 50 },
    distal: { x: mesialRight ? 20 : 80, y: 50 },
    buccal: { x: 50, y: upper ? 17 : 83 },
    lingual: { x: 50, y: upper ? 83 : 17 },
    occlusal: { x: 50, y: 50 },
  } as Record<Surface, { x: number; y: number }>;
}

const SURFACES: Surface[] = ['mesial', 'occlusal', 'distal', 'buccal', 'lingual'];

function tooth(fdi: number) {
  const q = Math.floor(fdi / 10);
  const pos = fdi % 10;
  const meta = QUADRANTS[q];
  const mark = marks[fdi];
  const scoped = mark && SURFACE_SCOPED.includes(mark.condition);
  return {
    fdi,
    universal: meta.universalStart + (meta.ascending ? pos - 1 : 8 - pos),
    palmer: `${meta.palmer}${pos}`,
    // Whole-tooth conditions paint the tooth; surface conditions leave it
    // sound and show pips instead.
    state: (mark && !scoped ? mark.condition : 'sound') as ToothCondition,
    surfaceCondition: scoped ? mark!.condition : '',
    surfaces: scoped ? (mark!.surfaces ?? []) : [],
    pips: pips(fdi),
    lower: q === 3 || q === 4,
  };
}

const rows = {
  upperRight: [18, 17, 16, 15, 14, 13, 12, 11].map(tooth),
  upperLeft: [21, 22, 23, 24, 25, 26, 27, 28].map(tooth),
  lowerRight: [48, 47, 46, 45, 44, 43, 42, 41].map(tooth),
  lowerLeft: [31, 32, 33, 34, 35, 36, 37, 38].map(tooth),
};

// Visual order for arrow-key movement.
const flat = [...rows.upperRight, ...rows.upperLeft, ...rows.lowerRight, ...rows.lowerLeft];
const firstFdi = flat[0].fdi;

function describe(t: ReturnType<typeof tooth>, name: string | number) {
  if (t.surfaceCondition) {
    const codes = surfaceSummary(t.fdi, t.surfaces);
    return `Tooth ${name}, ${CONDITION_LABEL[t.surfaceCondition as ToothCondition]} on ${codes}. Activate to edit.`;
  }
  return `Tooth ${name}, ${CONDITION_LABEL[t.state]}. Activate to edit.`;
}

const notations = [
  { id: 'fdi', label: 'FDI' },
  { id: 'universal', label: 'Universal' },
  { id: 'palmer', label: 'Palmer' },
];

const legend = [
  { label: 'Caries', cls: 'bg-caries' },
  { label: 'Filled', cls: 'bg-accent' },
  { label: 'Crown', cls: 'bg-crown' },
  { label: 'Missing', cls: 'bg-[var(--c-tooth-missing)]' },
];

const surfaceConditions: ToothCondition[] = ['caries', 'filled', 'sealant'];
const wholeConditions: ToothCondition[] = [
  'crown', 'bridge', 'veneer', 'root_canal', 'implant', 'missing', 'unerupted', 'impacted',
];
---

<div data-odontogram data-notation={notation} class="flex flex-col gap-7 border border-line bg-surface p-6 sm:p-8 lg:flex-row">
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <fieldset class="flex items-center gap-2">
        <legend class="sr-only">Tooth notation system</legend>
        {notations.map((n) => (
          <label class="cursor-pointer">
            <input type="radio" name="notation" value={n.id} checked={n.id === notation} class="peer sr-only" data-notation-input />
            <span class="block border border-line px-3 py-1.5 text-xs font-medium text-ink-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-surface">
              {n.label}
            </span>
          </label>
        ))}
      </fieldset>
      <div class="flex flex-wrap gap-4">
        {legend.map((g) => (
          <span class="flex items-center gap-1.5 text-xs text-ink-2"><span class={`swatch ${g.cls}`}></span>{g.label}</span>
        ))}
      </div>
    </div>

    {([['upperRight', 'upperLeft'], ['lowerRight', 'lowerLeft']] as const).map(([a, b], archIndex) => (
      <>
        {archIndex === 1 && (
          <div class="my-3.5 flex items-center gap-3.5">
            <div class="h-px flex-1 bg-line-2"></div>
            <span class="text-[11px] tracking-[0.08em] text-faint uppercase">Midline</span>
            <div class="h-px flex-1 bg-line-2"></div>
          </div>
        )}
        <div class={`flex justify-center gap-4 overflow-x-auto ${archIndex === 0 ? 'mt-6 pb-1' : 'pt-1'}`}>
          {[rows[a], rows[b]].map((quadrant) => (
            <div class="flex gap-[5px]">
              {quadrant.map((t) => (
                <div class={`flex items-center gap-1.5 ${t.lower ? 'flex-col-reverse' : 'flex-col'}`}>
                  <button
                    type="button"
                    class:list={['tooth', t.lower && 'tooth--lower']}
                    data-tooth
                    data-state={t.state}
                    data-surface-condition={t.surfaceCondition}
                    data-fdi={t.fdi}
                    data-universal={t.universal}
                    data-palmer={t.palmer}
                    tabindex={t.fdi === firstFdi ? 0 : -1}
                    aria-haspopup="dialog"
                    aria-label={describe(t, t[notation])}
                  >
                    {SURFACES.map((s) => (
                      <span
                        class="pip"
                        data-surface={s}
                        data-on={t.surfaces.includes(s) ? '' : undefined}
                        style={`left:${t.pips[s].x}%;top:${t.pips[s].y}%`}
                      ></span>
                    ))}
                  </button>
                  <span class="text-[11px] tabular-nums text-muted" data-label>{t[notation]}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </>
    ))}

    <p class="mt-6 text-[13px] text-muted">
      Click a tooth to pick a finding and its surfaces. Arrow keys move between teeth.
    </p>
  </div>

  <div class="flex w-full shrink-0 flex-col border border-line-2 bg-bg-soft p-5 lg:w-[290px]">
    <div class="flex items-baseline justify-between">
      <span class="text-xs font-semibold tracking-[0.1em] text-muted uppercase">Chart note</span>
      <span data-count class="text-xs tabular-nums text-muted"></span>
    </div>
    <p data-note-empty class="mt-3.5 text-sm leading-relaxed text-muted">
      Nothing charted yet. Mark a tooth and it lands here, the way it would in a real patient record.
    </p>
    <ul data-note-list class="mt-3.5 flex flex-col gap-2.5" hidden></ul>
    <div class="min-h-4 flex-1"></div>
    <button type="button" data-clear class="mt-4 w-full cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">
      Clear chart
    </button>
  </div>

  <!-- One shared palette, moved to the clicked tooth. Native popover gives
       Escape, light-dismiss and focus handling without writing any of it. -->
  <div popover data-palette role="dialog" aria-label="Tooth finding" class="w-[320px] border border-line bg-surface p-4">
    <p class="font-display text-[17px] font-semibold" data-palette-title>Tooth</p>

    <div data-surface-block>
      <p class="mt-3 text-xs font-semibold tracking-[0.09em] text-muted uppercase">Surfaces</p>
      <div class="mt-2 grid grid-cols-5 gap-1.5">
        {SURFACES.map((s) => (
          <button
            type="button"
            data-surface-toggle={s}
            aria-pressed="false"
            class="cursor-pointer border border-line py-2.5 text-[13px] font-semibold text-ink-2 aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-surface"
          >
            <span data-surface-code>{s === 'occlusal' ? 'O' : SURFACE_LABEL[s][0]}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="mt-4 text-xs font-semibold tracking-[0.09em] text-muted uppercase">Per surface</p>
    <div class="mt-2 grid grid-cols-3 gap-1.5">
      {surfaceConditions.map((c) => (
        <button type="button" data-condition={c} data-scope="surface" class="cursor-pointer border border-line px-2 py-2.5 text-[13px] font-medium hover:border-accent hover:text-accent">
          {CONDITION_LABEL[c]}
        </button>
      ))}
    </div>

    <p class="mt-4 text-xs font-semibold tracking-[0.09em] text-muted uppercase">Whole tooth</p>
    <div class="mt-2 grid grid-cols-3 gap-1.5">
      {wholeConditions.map((c) => (
        <button type="button" data-condition={c} data-scope="whole" class="cursor-pointer border border-line px-2 py-2.5 text-[12.5px] font-medium hover:border-accent hover:text-accent">
          {CONDITION_LABEL[c]}
        </button>
      ))}
    </div>

    <button type="button" data-condition="sound" data-scope="whole" class="mt-3 w-full cursor-pointer border border-line px-3 py-2.5 text-[13px] font-medium text-ink-2 hover:border-caries hover:text-caries">
      Clear this tooth
    </button>
  </div>
</div>

<script>
  import {
    CONDITION_LABEL, SURFACE_SCOPED, SURFACE_LABEL, occlusalWord, occlusalCode, surfaceSummary,
    type ToothCondition, type ToothMark, type Surface,
  } from '../data/demo';

  const SURFACES: Surface[] = ['mesial', 'occlusal', 'distal', 'buccal', 'lingual'];
  const SWATCH: Record<string, string> = {
    caries: 'var(--c-caries)', filled: 'var(--c-accent)', sealant: '#0ea5e9',
    crown: 'var(--c-crown)', bridge: 'var(--c-crown)', veneer: '#d946ef',
    root_canal: '#8b5cf6', implant: '#64748b', missing: 'var(--c-tooth-missing)',
    unerupted: 'var(--c-muted)', impacted: 'var(--c-muted)',
  };

  document.querySelectorAll<HTMLElement>('[data-odontogram]').forEach((root) => {
    const teeth = [...root.querySelectorAll<HTMLButtonElement>('button[data-tooth]')];
    const palette = root.querySelector<HTMLElement>('[data-palette]')!;
    const title = palette.querySelector<HTMLElement>('[data-palette-title]')!;
    const surfaceBlock = palette.querySelector<HTMLElement>('[data-surface-block]')!;
    const list = root.querySelector<HTMLElement>('[data-note-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-note-empty]')!;
    const counter = root.querySelector<HTMLElement>('[data-count]')!;

    const marks = new Map<HTMLButtonElement, ToothMark>();
    let active: HTMLButtonElement | null = null;
    let picked = new Set<Surface>();

    const fdiOf = (b: HTMLButtonElement) => Number(b.dataset.fdi);
    const nameOf = (b: HTMLButtonElement) => b.dataset[root.dataset.notation ?? 'fdi'] ?? b.dataset.fdi!;

    // Seed from what the server rendered so an existing chart survives hydration.
    teeth.forEach((b) => {
      const whole = b.dataset.state;
      const surf = b.dataset.surfaceCondition;
      if (surf) {
        const on = [...b.querySelectorAll<HTMLElement>('.pip[data-on]')].map((p) => p.dataset.surface as Surface);
        marks.set(b, { condition: surf as ToothCondition, surfaces: on });
      } else if (whole && whole !== 'sound') {
        marks.set(b, { condition: whole as ToothCondition });
      }
    });

    function describe(b: HTMLButtonElement) {
      const m = marks.get(b);
      const name = nameOf(b);
      if (!m) return `Tooth ${name}, Sound. Activate to edit.`;
      if (m.surfaces?.length) {
        return `Tooth ${name}, ${CONDITION_LABEL[m.condition]} on ${surfaceSummary(fdiOf(b), m.surfaces)}. Activate to edit.`;
      }
      return `Tooth ${name}, ${CONDITION_LABEL[m.condition]}. Activate to edit.`;
    }

    function paint(b: HTMLButtonElement) {
      const m = marks.get(b);
      const scoped = m && SURFACE_SCOPED.includes(m.condition);
      b.dataset.state = m && !scoped ? m.condition : 'sound';
      b.dataset.surfaceCondition = scoped ? m!.condition : '';
      b.querySelectorAll<HTMLElement>('.pip').forEach((p) => {
        const on = scoped && m!.surfaces?.includes(p.dataset.surface as Surface);
        if (on) p.setAttribute('data-on', '');
        else p.removeAttribute('data-on');
      });
      b.setAttribute('aria-label', describe(b));
    }

    function render() {
      const entries = teeth.filter((b) => marks.has(b));
      counter.textContent = entries.length ? `${entries.length} marked` : '';
      empty.hidden = entries.length > 0;
      list.hidden = entries.length === 0;
      list.replaceChildren(
        ...entries.map((b) => {
          const m = marks.get(b)!;
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2.5';

          const dot = document.createElement('span');
          dot.className = 'swatch ';
          dot.style.background = SWATCH[m.condition] ?? 'var(--c-muted)';

          const num = document.createElement('span');
          num.className = 'min-w-12 text-sm font-semibold tabular-nums';
          const codes = surfaceSummary(fdiOf(b), m.surfaces);
          num.textContent = codes ? `${nameOf(b)} ${codes}` : nameOf(b);

          const label = document.createElement('span');
          label.className = 'text-sm text-ink-2';
          label.textContent = CONDITION_LABEL[m.condition];

          li.append(dot, num, label);
          return li;
        })
      );
    }

    function openPalette(b: HTMLButtonElement) {
      active = b;
      const fdi = fdiOf(b);
      const m = marks.get(b);
      picked = new Set(m?.surfaces ?? []);

      title.textContent = `Tooth ${nameOf(b)}`;
      // Anteriors have an incisal edge, not an occlusal table.
      palette.querySelector<HTMLElement>('[data-surface-toggle="occlusal"] [data-surface-code]')!
        .textContent = occlusalCode(fdi);
      palette.querySelector<HTMLButtonElement>('[data-surface-toggle="occlusal"]')!
        .title = occlusalWord(fdi);
      syncSurfaces();

      palette.showPopover();
      const r = b.getBoundingClientRect();
      const w = palette.offsetWidth;
      const left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), innerWidth - w - 8);
      const below = r.bottom + 10;
      const fits = below + palette.offsetHeight < innerHeight - 8;
      palette.style.left = `${left}px`;
      palette.style.top = fits ? `${below}px` : `${Math.max(8, r.top - palette.offsetHeight - 10)}px`;
    }

    function syncSurfaces() {
      palette.querySelectorAll<HTMLButtonElement>('[data-surface-toggle]').forEach((t) => {
        t.setAttribute('aria-pressed', String(picked.has(t.dataset.surfaceToggle as Surface)));
      });
    }

    teeth.forEach((b) => {
      b.addEventListener('click', () => openPalette(b));
      b.addEventListener('keydown', (e) => {
        const i = teeth.indexOf(b);
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1
          : e.key === 'ArrowDown' ? 16 : e.key === 'ArrowUp' ? -16 : 0;
        if (!step) return;
        e.preventDefault();
        const next = teeth[(i + step + teeth.length) % teeth.length];
        // Roving tabindex: 32 tab stops in a row is not navigation.
        b.tabIndex = -1;
        next.tabIndex = 0;
        next.focus();
      });
    });

    palette.querySelectorAll<HTMLButtonElement>('[data-surface-toggle]').forEach((t) => {
      t.addEventListener('click', () => {
        const s = t.dataset.surfaceToggle as Surface;
        picked.has(s) ? picked.delete(s) : picked.add(s);
        syncSurfaces();
      });
    });

    palette.querySelectorAll<HTMLButtonElement>('[data-condition]').forEach((c) => {
      c.addEventListener('click', () => {
        if (!active) return;
        const condition = c.dataset.condition as ToothCondition;
        if (condition === 'sound') {
          marks.delete(active);
        } else if (c.dataset.scope === 'surface') {
          // Default to the biting surface rather than refusing the click --
          // it is the common case and the dentist can add more.
          const surfaces = picked.size ? [...picked] : (['occlusal'] as Surface[]);
          marks.set(active, { condition, surfaces });
        } else {
          marks.set(active, { condition });
        }
        paint(active);
        render();
        palette.hidePopover();
        active.focus();
      });
    });

    root.querySelectorAll<HTMLInputElement>('[data-notation-input]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        root.dataset.notation = input.value;
        teeth.forEach((b) => {
          const label = b.parentElement?.querySelector<HTMLElement>('[data-label]');
          if (label) label.textContent = nameOf(b);
          b.setAttribute('aria-label', describe(b));
        });
        render();
      });
    });

    root.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
      marks.clear();
      teeth.forEach(paint);
      render();
    });

    render();
  });
</script>
